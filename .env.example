# Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/networkd?schema=public"

# NextAuth / Auth.js v5
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (must enable Google Calendar API in the GCP project)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Stripe (test mode)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Platform config
PLATFORM_FEE_BPS="1500"        # 15% in basis points
APP_URL="http://localhost:3000"
